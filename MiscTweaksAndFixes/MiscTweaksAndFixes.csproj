<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <VersionPrefix>2.4.3</VersionPrefix>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <VersionSuffix>debug-$([System.DateTimeOffset]::UtcNow.ToString(yyyyMMdd-HHmm))</VersionSuffix>
  </PropertyGroup>
  
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <OutDir>$(SolutionDir)\bin\$(Configuration)\$(TargetFramework)\$(MSBuildProjectName)</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="AddedContent\RipAndTear\Resources\*.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" IncludeAssets="build; contentfiles" Version="0.4.2" PrivateAssets="all" />
    <PackageReference Include="MicroWrath" Version="0.10.0-*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(WrathPath)\Wrath_Data\Managed\UnityModManager\0Harmony.dll" Private="False" />
    <Reference Include="$(WrathPath)\Wrath_Data\Managed\Assembly-CSharp-firstpass.dll" Private="False" />
    <Reference Include="$(WrathPath)\Wrath_Data\Managed\Unity*.dll" Private="false" />
    <Reference Include="$(WrathPath)\Wrath_Data\Managed\Core*.dll" Private="false" />
    <Reference Include="$(WrathPath)\Wrath_Data\Managed\Owlcat*.dll" Publicize="true" Private="false" />
    <Reference Include="$(WrathPath)\Wrath_Data\Managed\Assembly-CSharp.dll*" Publicize="true" Private="false" />
    <Reference Include="$(WrathPath)\Wrath_Data\Managed\UnityModManager\UnityModManager.dll*" Publicize="true" Private="false" />
    <Reference Include="$(WrathPath)\Wrath_Data\Managed\Newtonsoft.Json.dll*" Private="false" />
    <Reference Include="$(WrathPath)\Wrath_Data\Managed\UnityModManager\0Harmony.dll*" Private="false" />
    <Reference Include="$(WrathPath)\Wrath_Data\Managed\UniRx.dll*" Private="False" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ModMenu" HintPath="D:\SteamLibrary\steamapps\common\Pathfinder Second Adventure\Mods\ModMenu\ModMenu.dll" Private="False" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wat\Wat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Info.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="GenerateGuidsFileTarget" AfterTargets="Build">
    <ItemGroup>
      <Requirements Include="ModMenu-1.3.0"/>
    </ItemGroup>
    <GenerateGuidsFile WrathPath="$(WrathPath)" Assembly="$(OutDir)\$(MSBuildProjectName).dll" GuidsFile="guids.json" References="@(ReferencePath)" />
    <InfoJson
      OutputPath="$(OutDir)"
      Id="MiscTweaksAndFixes"
      Version="$(VersionPrefix)"
      DisplayName="Miscellaneous Tweaks and Fixes"
      Author="microsoftenator"
      Requirements="@(Requirements)"
      GameVersion="2.3.0"
      ManagerVersion="0.27.11"
      HomePage="https://github.com/microsoftenator2022/MiscTweaksAndFixes2"
      Repository="https://raw.githubusercontent.com/microsoftenator2022/MiscTweaksAndFixes2/master/Repository.json" />
  </Target>
  
  <Target Name="Deploy" AfterTargets="Build">
    <ItemGroup>
      <Files Include="$(SolutionDir)\bin\$(Configuration)\$(TargetFramework)\$(MSBuildProjectName)\**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(Files)" DestinationFolder="$(WrathPath)\Mods\$(MSBuildProjectName)" />
  </Target>

  <Target Name="ZipRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ZipDirectory SourceDirectory="$(OutDir)" DestinationFile="$(SolutionDir)\bin\$(MSBuildProjectName)-$(Version).zip" Overwrite="true" />
  </Target>

</Project>
